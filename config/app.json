{
  "project": "DS-Harness (Alien-derived)",
  "version": "1.0.0-alien-rebuild",
  "apiBaseURL": "https://api.deepseek.com",
  "harness": {
    "npmPackage": "@deepseek-ai/dsh",
    "version": "0.1.2-rc.1",
    "defaultProvider": "deepseek-official",
    "defaultModel": "deepseek-v4-flash",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "profile": "web",
    "host": "127.0.0.1",
    "port": 3080
  },
  "extensions": {
    "mega": {
      "enabledByDefault": true,
      "disableEnv": "DSH_DISABLE_MEGA",
      "toolsShortcut": "Ctrl+Shift+M"
    }
  },
  "subWorker": {
    "enabledOnStartup": false,
    "maxWorkers": 1,
    "autoDelegate": false,
    "workspaceMode": "isolated_worktree",
    "keepChangesOnStop": true,
    "allowGitCommit": false,
    "showNotifications": true,
    "adaptiveWorkers": false,
    "resources": {
      "workers": { "min": 1, "softMax": "auto", "hardMax": "auto" },
      "resources": { "cpuReservePercent": 20, "ramReservePercent": 20, "ramReserveMinGb": 4 },
      "scaling": { "enabled": true, "scaleUpDelaySeconds": 30, "scaleDownDelaySeconds": 60 },
      "speculativeExecution": { "enabled": true }
    }
  },
  "computerUse": {
    "enabled": true,
    "autonomyEnabled": false,
    "limits": {
      "maxSteps": 200,
      "maxRetriesPerAction": 2,
      "maxStallRecoveries": 2,
      "stepTimeoutMs": 30000,
      "runTimeoutMs": 1800000
    },
    "timing": {
      "settleMinMs": 50,
      "settlePreferredMs": 100,
      "gracePreferredMs": 150,
      "cooldownSoftMaxMs": 400,
      "navigationCooldownMs": 800,
      "eventPollMs": 40
    },
    "safety": {
      "destructiveActions": "confirm",
      "requireForegroundWindow": true,
      "requireFocusForTyping": true
    },
    "vision": {
      "retention": "failure",
      "allowFullScreenFallback": true
    }
  },
  "timezones": {
    "local": "auto",
    "localLabel": "本地时间(系统时区)",
    "billing": "Asia/Shanghai",
    "billingLabel": "计费时间(北京时间)"
  },
  "taskHistory": { "maxEntries": 50 }
}
