{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshns.invalid/evidence/engineering-recovery/v1",
  "title": "DS-Hns external crash-recovery evidence schema v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/evidenceFreeze"},
    {"$ref": "#/$defs/batchManifest"},
    {"$ref": "#/$defs/runManifest"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/oracleDocument"},
    {"$ref": "#/$defs/e0Gate"}
  ],
  "$defs": {
    "cursor": {
      "type": "object",
      "required": ["nextStepIndex"],
      "properties": {
        "nextStepIndex": {"type": "integer", "minimum": 0},
        "lastVerifiedStepId": {"type": ["string", "null"], "maxLength": 256},
        "verifiedStepIds": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "skippedStepIds": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "checkpointSeq": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": ["applicable", "pass", "observations", "sourceEventSeqs", "failureReason"],
      "properties": {
        "applicable": {"type": "boolean"},
        "pass": {"type": ["boolean", "null"]},
        "observations": {"type": "object"},
        "sourceEventSeqs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "failureReason": {"type": ["string", "null"], "maxLength": 256}
      },
      "additionalProperties": false
    },
    "oracleSet": {
      "type": "object",
      "required": ["O1_progress_preservation", "O2_no_verified_replay", "O3_no_duplicate_effect", "O4_cursor_monotonic", "O5_fail_closed_correct", "O6_single_execution_owner", "O7_cleanup_safety", "O8_cleanup_completeness", "O9_reboot_autonomy"],
      "properties": {
        "O1_progress_preservation": {"type": ["boolean", "null"]},
        "O2_no_verified_replay": {"type": ["boolean", "null"]},
        "O3_no_duplicate_effect": {"type": ["boolean", "null"]},
        "O4_cursor_monotonic": {"type": ["boolean", "null"]},
        "O5_fail_closed_correct": {"type": ["boolean", "null"]},
        "O6_single_execution_owner": {"type": ["boolean", "null"]},
        "O7_cleanup_safety": {"type": ["boolean", "null"]},
        "O8_cleanup_completeness": {"type": ["boolean", "null"]},
        "O9_reboot_autonomy": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["batchId", "runId", "episodeId", "eventSeq", "monotonicMs", "wallTime", "type"],
      "properties": {
        "batchId": {"type": "string", "maxLength": 128},
        "runId": {"type": "string", "maxLength": 128},
        "episodeId": {"type": "string", "maxLength": 128},
        "eventSeq": {"type": "integer", "minimum": 1},
        "monotonicMs": {"type": "number", "minimum": 0},
        "wallTime": {"type": "string", "format": "date-time"},
        "type": {"enum": ["episode_started", "checkpoint_observed", "fault_armed", "fault_injected", "target_exit_observed", "relaunch_started", "windows_session_restored", "app_relaunched", "recovery_candidate_detected", "recovery_claim_acquired", "recovery_verified", "resume_accepted", "first_post_resume_checkpoint", "recovery_blocked", "cross_volume_temp_registered", "cleanup_started", "cleanup_entry_deleted", "cleanup_entry_preserved_unowned", "cleanup_retry", "cleanup_verified", "episode_completed", "run_stopped", "mutation_effect", "sentinel_observed", "owner_snapshot", "step_observed", "product_result_observed", "fault_not_run"]},
        "faultId": {"type": "integer", "minimum": 1, "maximum": 89},
        "checkpointSeq": {"type": "integer", "minimum": 1},
        "cursor": {"$ref": "#/$defs/cursor"},
        "code": {"type": "string", "maxLength": 100},
        "reason": {"type": "string", "maxLength": 256},
        "verifiedStepIds": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "verifiedMutationIds": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "mutationId": {"type": "string", "maxLength": 256},
        "effectId": {"type": "string", "maxLength": 256},
        "effect": {"type": "string", "maxLength": 32},
        "phase": {"type": "string", "maxLength": 32},
        "liveOwnerCount": {"type": "integer", "minimum": 0},
        "ownerId": {"type": "string", "maxLength": 128},
        "owners": {"type": "array", "items": {"type": "string", "maxLength": 128}},
        "pathId": {"type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "entryType": {"type": "string", "enum": ["file", "directory"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "residualCount": {"type": "integer", "minimum": 0},
        "sameAccount": {"type": "boolean"},
        "manualCredentialPromptObserved": {"type": "boolean"},
        "stepId": {"type": "string", "maxLength": 256},
        "stepOutcome": {"type": "string", "maxLength": 32},
        "mutationCount": {"type": "integer", "minimum": 0},
        "latencyMs": {"type": "number", "minimum": 0},
        "actualOutcome": {"type": "string", "maxLength": 100},
        "result": {"type": "string", "maxLength": 100},
        "candidateId": {"type": "string", "maxLength": 128}
      },
      "additionalProperties": false
    },
    "runManifest": {
      "type": "object",
      "required": ["schemaVersion", "batchId", "runId", "runOrdinal", "seed", "implementationSha", "harnessSha", "sourceRef", "evidenceSchemaSha256", "sourceSpecSha256", "workloadId", "workloadVersion", "workloadSha256", "workloadStepIds", "faultCatalogVersion", "faultCatalogSha256", "faultFamily", "faultId", "injectionPoint", "expectedOutcome", "expectedBlockCode", "executionMode", "pairId", "episodeId", "runtime", "os", "hostProfileId", "logicalCpuCount", "memoryBucketGb", "storageVolumeRoles", "selectedWorkVolume", "taskScratchVolumes", "candidateRoot", "recoveryConfigurationSha256", "classificationPhase", "startedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "batchId": {"type": "string", "maxLength": 128},
        "runId": {"type": "string", "maxLength": 128},
        "runOrdinal": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "implementationSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "harnessSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "sourceRef": {"type": ["string", "null"], "maxLength": 160, "pattern": "^[A-Za-z0-9._/-]{1,160}$"},
        "evidenceSchemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workloadId": {"enum": ["W0", "W1", "W2", "W3", "W4"]},
        "workloadVersion": {"type": "string", "maxLength": 64},
        "workloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workloadStepIds": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 256}},
        "faultCatalogVersion": {"type": "string", "maxLength": 64},
        "faultCatalogSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "faultFamily": {"type": "string", "maxLength": 64},
        "faultId": {"type": "integer", "minimum": 1, "maximum": 89},
        "injectionPoint": {"type": "string", "maxLength": 128},
        "expectedOutcome": {"type": "string", "maxLength": 128},
        "expectedBlockCode": {"type": ["string", "null"], "maxLength": 100},
        "executionMode": {"enum": ["adapter-simulated", "controlled-owned-process", "maintenance-window"]},
        "pairId": {"type": ["string", "null"], "maxLength": 128},
        "episodeId": {"type": "string", "maxLength": 128},
        "runtime": {"type": "string", "maxLength": 64},
        "os": {"type": "string", "maxLength": 128},
        "hostProfileId": {"type": "string", "maxLength": 128},
        "logicalCpuCount": {"type": "integer", "minimum": 1},
        "memoryBucketGb": {"type": "integer", "minimum": 1},
        "storageVolumeRoles": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 64}},
        "selectedWorkVolume": {"type": "string", "pattern": "^[A-Z]:$"},
        "taskScratchVolumes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]:$"}},
        "candidateRoot": {"type": "string", "maxLength": 256, "pattern": "^(?![A-Za-z]:|\\\\).+"},
        "recoveryConfigurationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "classificationPhase": {"enum": ["DIAGNOSTIC", "PILOT", "FINAL"]},
        "startedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["schemaVersion", "batchId", "runId", "runOrdinal", "faultId", "workloadId", "seed", "classification", "expectedOutcome", "actualOutcome", "lostVerifiedSteps", "verifiedMutationReplayCount", "duplicateEffectCount", "oracle"],
      "properties": {
        "schemaVersion": {"const": 1},
        "batchId": {"type": "string"},
        "runId": {"type": "string"},
        "runOrdinal": {"type": "integer", "minimum": 1},
        "faultId": {"type": "integer", "minimum": 1, "maximum": 89},
        "workloadId": {"enum": ["W0", "W1", "W2", "W3", "W4"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "classification": {"enum": ["PASS", "EXPECTED_BLOCK", "FAIL", "INVALID"]},
        "invalidReason": {"type": ["string", "null"]},
        "expectedOutcome": {"type": "string"},
        "actualOutcome": {"type": "string"},
        "eligibleResume": {"type": "boolean"},
        "resumeSucceeded": {"type": "boolean"},
        "resumeProofReached": {"type": "boolean"},
        "blockedReason": {"type": ["string", "null"]},
        "checkpointSeqBeforeFault": {"type": ["integer", "null"]},
        "cursorBeforeFault": {"type": ["integer", "null"]},
        "checkpointSeqAfterRecovery": {"type": ["integer", "null"]},
        "cursorAfterRecovery": {"type": ["integer", "null"]},
        "lostVerifiedSteps": {"type": "integer", "minimum": 0},
        "verifiedMutationReplayCount": {"type": "integer", "minimum": 0},
        "duplicateEffectCount": {"type": "integer", "minimum": 0},
        "stepsReexecuted": {"type": "integer", "minimum": 0},
        "verifiedStepsPreserved": {"type": "integer", "minimum": 0},
        "faultToCandidateMs": {"type": ["number", "null"]},
        "faultToResumeAcceptedMs": {"type": ["number", "null"]},
        "faultToFirstNewCheckpointMs": {"type": ["number", "null"]},
        "cleanupDurationMs": {"type": ["number", "null"]},
        "offWorkVolumeTempCreatedCount": {"type": "integer", "minimum": 0},
        "offWorkVolumeTempDeletedCount": {"type": "integer", "minimum": 0},
        "offWorkVolumeResidualCount": {"type": ["integer", "null"], "minimum": 0},
        "fallbackToOlderCheckpoint": {"type": "boolean"},
        "claimConflictCount": {"type": "integer", "minimum": 0},
        "sameWindowsAccount": {"type": ["boolean", "null"]},
        "manualCredentialPromptObserved": {"type": ["boolean", "null"]},
        "testStopReason": {"type": ["string", "null"], "maxLength": 256},
        "totalCompletionMs": {"type": ["number", "null"]},
        "oracle": {"$ref": "#/$defs/oracleSet"}
      },
      "additionalProperties": false
    },
    "oracleDocument": {
      "type": "object",
      "required": ["schemaVersion", "batchId", "runId", "oracle"],
      "properties": {
        "schemaVersion": {"const": 1},
        "batchId": {"type": "string", "maxLength": 128},
        "runId": {"type": "string", "maxLength": 128},
        "oracle": {"type": "object", "required": ["O1_progress_preservation", "O2_no_verified_replay", "O3_no_duplicate_effect", "O4_cursor_monotonic", "O5_fail_closed_correct", "O6_single_execution_owner", "O7_cleanup_safety", "O8_cleanup_completeness", "O9_reboot_autonomy"], "properties": {
          "O1_progress_preservation": {"$ref": "#/$defs/oracle"},
          "O2_no_verified_replay": {"$ref": "#/$defs/oracle"},
          "O3_no_duplicate_effect": {"$ref": "#/$defs/oracle"},
          "O4_cursor_monotonic": {"$ref": "#/$defs/oracle"},
          "O5_fail_closed_correct": {"$ref": "#/$defs/oracle"},
          "O6_single_execution_owner": {"$ref": "#/$defs/oracle"},
          "O7_cleanup_safety": {"$ref": "#/$defs/oracle"},
          "O8_cleanup_completeness": {"$ref": "#/$defs/oracle"},
          "O9_reboot_autonomy": {"$ref": "#/$defs/oracle"}
        }, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "evidenceFreeze": {
      "type": "object",
      "required": ["schemaVersion", "batchId", "phase", "seed", "implementationSha", "harnessSha", "sourceRef", "sourceSpecSha256", "evidenceSchemaSha256", "faultCatalogVersion", "faultCatalogSha256", "workloadVersion", "workloadDefinitionsSha256", "pilotRunsExcludedFromFinalAggregates", "e0GateSha256", "frozenAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "batchId": {"type": "string", "maxLength": 128},
        "phase": {"enum": ["DIAGNOSTIC", "PILOT", "FINAL"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "implementationSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "harnessSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "sourceRef": {"type": ["string", "null"], "maxLength": 160, "pattern": "^[A-Za-z0-9._/-]{1,160}$"},
        "sourceSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidenceSchemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "faultCatalogVersion": {"type": "string", "maxLength": 64},
        "faultCatalogSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workloadVersion": {"type": "string", "maxLength": 64},
        "workloadDefinitionsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pilotRunsExcludedFromFinalAggregates": {"type": "boolean"},
        "e0GateSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "frozenAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "batchRun": {
      "type": "object",
      "required": ["runId", "runOrdinal", "classification", "faultId", "workloadId", "sha256sumsSha256"],
      "properties": {
        "runId": {"type": "string", "maxLength": 128},
        "runOrdinal": {"type": "integer", "minimum": 1},
        "classification": {"enum": ["PASS", "EXPECTED_BLOCK", "FAIL", "INVALID"]},
        "faultId": {"type": "integer", "minimum": 1, "maximum": 89},
        "workloadId": {"enum": ["W0", "W1", "W2", "W3", "W4"]},
        "sha256sumsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "batchManifest": {
      "type": "object",
      "required": ["schemaVersion", "batchId", "phase", "seed", "createdAt", "implementationSha", "harnessSha", "sourceRef", "evidenceSchemaSha256", "sourceSpecSha256", "faultCatalogVersion", "faultCatalogSha256", "workloadVersion", "workloadDefinitionsSha256", "pilotRunsExcludedFromFinalAggregates", "e0GateSha256", "runs"],
      "properties": {
        "schemaVersion": {"const": 1},
        "batchId": {"type": "string", "maxLength": 128},
        "phase": {"enum": ["DIAGNOSTIC", "PILOT", "FINAL"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "createdAt": {"type": "string", "format": "date-time"},
        "implementationSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "harnessSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$"},
        "sourceRef": {"type": ["string", "null"], "maxLength": 160, "pattern": "^[A-Za-z0-9._/-]{1,160}$"},
        "evidenceSchemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "faultCatalogVersion": {"type": "string", "maxLength": 64},
        "faultCatalogSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workloadVersion": {"type": "string", "maxLength": 64},
        "workloadDefinitionsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pilotRunsExcludedFromFinalAggregates": {"type": "boolean"},
        "e0GateSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/batchRun"}}
      },
      "additionalProperties": false
    },
    "e0GateRecord": {
      "type": "object",
      "required": ["id", "status", "exitCode", "durationMs", "logSha256"],
      "properties": {
        "id": {"enum": ["syntax", "full-unit", "focused-recovery", "test-all"]},
        "status": {"enum": ["PASS", "FAIL"]},
        "exitCode": {"type": "integer"},
        "durationMs": {"type": "number", "minimum": 0},
        "logSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "tests": {"type": ["integer", "null"], "minimum": 0},
        "passed": {"type": ["integer", "null"], "minimum": 0},
        "failed": {"type": ["integer", "null"], "minimum": 0},
        "skipped": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "e0Gate": {
      "type": "object",
      "required": ["schemaVersion", "runId", "branch", "implementationSha", "runtime", "os", "tempVolume", "startedAt", "finishedAt", "gates", "passed"],
      "properties": {
        "schemaVersion": {"const": 1},
        "runId": {"type": "string", "maxLength": 128},
        "branch": {"type": "string", "maxLength": 128},
        "implementationSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "runtime": {"type": "string", "maxLength": 64},
        "os": {"type": "string", "maxLength": 160},
        "tempVolume": {"const": "D:"},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "gates": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/e0GateRecord"}},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
