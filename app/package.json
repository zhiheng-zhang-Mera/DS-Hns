{
  "name": "ds-harness",
  "private": true,
  "version": "1.0.0-alien-rebuild",
  "description": "Alien-derived DeepSeek Harness desktop shell with optional Mega feature extensions",
  "main": "desktop-main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron desktop-main.cjs",
    "desktop:alien": "set DSH_DISABLE_MEGA=1&& electron desktop-main.cjs",
    "check": "node ../scripts/check-syntax.cjs",
    "test": "node --test --test-concurrency=2 ../tests/unit/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.1"
  },
  "devDependencies": {
    "electron": "43.4.0"
  }
}
