-10-15T05:16:59Z","triggering_actor":{"login":"mrityunjay-pandey","id":140483827,"node_id":"U_kgDOCF-c8w","avatar_url":"https://avatars.githubusercontent.com/u/140483827?v=4","gravatar_id":"","url":"https://api.github.com/users/mrityunjay-pandey","html_url":"https://github.com/mrityunjay-pandey","followers_url":"https://api.github.com/users/mrityunjay-pandey/followers","following_url":"https://api.github.com/users/mrityunjay-pandey/following{/other_user}","gists_url":"https://api.github.com/users/mrityunjay-pandey/gists{/gist_id}","starred_url":"https://api.github.com/users/mrityunjay-pandey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrityunjay-pandey/subscriptions","organizations_url":"https://api.github.com/users/mrityunjay-pandey/orgs","repos_url":"https://api.github.com/users/mrityunjay-pandey/repos","events_url":"https://api.github.com/users/mrityunjay-pandey/events{/privacy}","received_events_url":"https://api.github.com/users/mrityunjay-pandey/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/nodejs/undici/actions/runs/38685945350/jobs","logs_url":"https://api.github.com/repos/nodejs/undici/actions/runs/38685945350/logs","check_suite_url":"https://api.github.com/repos/nodejs/undici/check-suites/104832039512","artifacts_url":"https://api.github.com/repos/nodejs/undici/actions/runs/38685945350/artifacts","cancel_url":"https://api.github.com/repos/nodejs/undici/actions/runs/38685945350/cancel","rerun_url":"https://api.github.com/repos/nodejs/undici/actions/runs/38685945350/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/nodejs/undici/actions/workflows/1324676","head_commit":{"id":"e6369133add6523b707a2098fea9c422d0adb707","tree_id":"e79a3aecadb7df074f82ae720e5448f9a61f212f","message":"fix: handle frozen globalThis in setGlobalDispatcher (#5574)\n\n* fix: handle frozen globalThis in setGlobalDispatcher\n\nWhen Object.freeze(globalThis) is called before undici globals are accessed,\nsetGlobalDispatcher would throw TypeError because it cannot extend globalThis.\n\nThis fix wraps the Object.defineProperty calls in try/catch. When globalThis\nis not extensible (frozen), the dispatcher is stored in a module-level\nfallback variable instead. getGlobalDispatcher is updated to return the\nfallback dispatcher when the globalThis property is not available.\n\nThis allows undici to work correctly even when globalThis has been frozen,\nwhich is recommended by Node.js security best practices (CWE-349).\n\nFixes issue where Object.freeze(globalThis) breaks undici access.\n\n* test: add unit test for frozen globalThis in setGlobalDispatcher\n\nAdd comprehensive test coverage for the frozen globalThis fix. Tests verify:\n1. setGlobalDispatcher does not throw when globalThis is frozen\n2. getGlobalDispatcher continues to return a valid dispatcher\n3. The fallback mechanism works correctly when globalThis is not extensible\n\nThis addresses the review feedback from mcollina requesting tests.\n\n* test: improve frozen globalThis test coverage\n\nAdd comprehensive test cases to ensure all code paths in the frozen globalThis\nfix are exercised. Tests verify:\n1. setGlobalDispatcher does not throw when globalThis is frozen\n2. getGlobalDispatcher returns a valid dispatcher\n3. Fallback dispatcher persists across multiple calls\n\nThis addresses review feedback requesting tests.\n\n(cherry picked from commit a0922b0b6b5db878881017abb6fca3bbcdea555a)\nSigned-off-by: Mrityunjay Pandey <mrityunjayp1409@gmail.com>","timestamp":"2026-10-14T23:04:12Z","author":{"name":"Mhayk Whandson","email":"hi@mhayk.com"},"committer":{"name":"Mrityunjay Pandey","email":"mrityunjayp1409@gmail.com"}},"repository":{"id":133092972,"node_id":"MDEwOlJlcG9zaXRvcnkxMzMwOTI5NzI=","name":"undici","full_name":"nodejs/undici","private":false,"owner":{"login":"nodejs","id":9950313,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5NTAzMTM=","avatar_url":"https://ava