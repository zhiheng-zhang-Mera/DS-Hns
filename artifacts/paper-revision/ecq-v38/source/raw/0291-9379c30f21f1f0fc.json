os_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"37df44a421817e7bb048fce834bf691abb0999d6","url":"https://api.github.com/repos/fastify/fastify/commits/37df44a421817e7bb048fce834bf691abb0999d6","html_url":"https://github.com/fastify/fastify/commit/37df44a421817e7bb048fce834bf691abb0999d6"},{"sha":"a07b0c508620a452cdc47b2943e48bf88f676883","url":"https://api.github.com/repos/fastify/fastify/commits/a07b0c508620a452cdc47b2943e48bf88f676883","html_url":"https://github.com/fastify/fastify/commit/a07b0c508620a452cdc47b2943e48bf88f676883"}],"stats":{"total":29,"additions":29,"deletions":0},"files":[{"sha":"3bdde089b319a29e61f3d5a043692c408c8411e4","filename":"test/hooks-async.test.js","status":"modified","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/fastify/fastify/blob/95ca841451575330a91da06c683fb6591f068008/test%2Fhooks-async.test.js","raw_url":"https://github.com/fastify/fastify/raw/95ca841451575330a91da06c683fb6591f068008/test%2Fhooks-async.test.js","contents_url":"https://api.github.com/repos/fastify/fastify/contents/test%2Fhooks-async.test.js?ref=95ca841451575330a91da06c683fb6591f068008","patch":"@@ -416,6 +416,35 @@ test('preHandler hooks should be able to block a request', (t, testDone) => {\n   })\n })\n \n+// The test above registers a single `onSend` hook. With two or more *async*\n+// `onSend` hooks the chain is no longer halted: the handler runs and overwrites\n+// the status code of the already-sent reply, so the response carries the hook's\n+// body under the handler's status. Marked `todo` because the intended semantics\n+// are still undecided - this pins the discrepancy rather than asserting which\n+// side of it is correct. See https://github.com/fastify/fastify/issues/7090\n+test('preHandler hooks should be able to block a request with 2+ async onSend hooks', { todo: 'https://github.com/fastify/fastify/issues/7090' }, async t => {\n+  const fastify = Fastify()\n+  let handlerRan = false\n+\n+  fastify.addHook('onSend', async (req, reply, payload) => payload)\n+  fastify.addHook('onSend', async (req, reply, payload) => payload)\n+\n+  fastify.addHook('preHandler', async (req, reply) => {\n+    reply.code(401).send({ error: 'unauthorized' })\n+  })\n+\n+  fastify.get('/', async (request, reply) => {\n+    handlerRan = true\n+    return reply.code(400).send({ error: 'handler ran' })\n+  })\n+\n+  const res = await fastify.inject('/')\n+\n+  t.assert.strictEqual(handlerRan, false, 'the handler should not run')\n+  t.assert.strictEqual(res.statusCode, 401)\n+  t.assert.deepStrictEqual(res.json(), { error: 'unauthorized' })\n+})\n+\n test('preValidation hooks should be able to block a request', (t, testDone) => {\n   t.plan(5)\n   const fastify = Fastify()"}]}