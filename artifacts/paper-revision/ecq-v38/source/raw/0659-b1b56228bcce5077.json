s://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"14c296ff2fc3fed97e5fb1cca3c090077ca38030","url":"https://api.github.com/repos/nodejs/undici/commits/14c296ff2fc3fed97e5fb1cca3c090077ca38030","html_url":"https://github.com/nodejs/undici/commit/14c296ff2fc3fed97e5fb1cca3c090077ca38030"},{"sha":"c687fe8b37569c93cc1639cea89009541508b58a","url":"https://api.github.com/repos/nodejs/undici/commits/c687fe8b37569c93cc1639cea89009541508b58a","html_url":"https://github.com/nodejs/undici/commit/c687fe8b37569c93cc1639cea89009541508b58a"}],"stats":{"total":44,"additions":44,"deletions":0},"files":[{"sha":"10d24cecfbd52af85ce0892618cf386b66548c7f","filename":"lib/interceptor/decompress.js","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nodejs/undici/blob/5fafc613b1b3591c82428e40ce386365434ea26c/lib%2Finterceptor%2Fdecompress.js","raw_url":"https://github.com/nodejs/undici/raw/5fafc613b1b3591c82428e40ce386365434ea26c/lib%2Finterceptor%2Fdecompress.js","contents_url":"https://api.github.com/repos/nodejs/undici/contents/lib%2Finterceptor%2Fdecompress.js?ref=5fafc613b1b3591c82428e40ce386365434ea26c","patch":"@@ -66,6 +66,7 @@ class DecompressController {\n \n /** @type {Record<string, () => DecompressorStream>} */\n const supportedEncodings = {\n+  __proto__: null,\n   gzip: createGunzip,\n   'x-gzip': createGunzip,\n   br: createBrotliDecompress,"},{"sha":"a47e3a5727b2857333e51cfa67e493e336531d7e","filename":"test/interceptors/decompress.js","status":"modified","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/nodejs/undici/blob/5fafc613b1b3591c82428e40ce386365434ea26c/test%2Finterceptors%2Fdecompress.js","raw_url":"https://github.com/nodejs/undici/raw/5fafc613b1b3591c82428e40ce386365434ea26c/test%2Finterceptors%2Fdecompress.js","contents_url":"https://api.github.com/repos/nodejs/undici/contents/test%2Finterceptors%2Fdecompress.js?ref=5fafc613b1b3591c82428e40ce386365434ea26c","patch":"@@ -303,6 +303,49 @@ test('should pass through unsupported encoding', async t => {\n   await t.completed\n })\n \n+// `constructor` and `__proto__` are the only Object.prototype member names that\n+// survive the toLowerCase() in onResponseStart, so they are the two an origin\n+// can actually put on the wire.\n+for (const encoding of ['constructor', '__proto__', 'gzip, constructor']) {\n+  test(`should pass through an Object.prototype name as an encoding: ${encoding}`, async t => {\n+    t = tspl(t, { plan: 3 })\n+\n+    const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {\n+      res.writeHead(200, {\n+        'Content-Type': 'text/plain',\n+        'Content-Encoding': encoding\n+      })\n+      res.end('This has unsupported encoding')\n+    })\n+\n+    server.listen(0)\n+    await once(server, 'listening')\n+\n+    const client = new Client(\n+      `http://localhost:${server.address().port}`\n+    ).compose(createDecompressInterceptor())\n+\n+    after(async () => {\n+      await client.close()\n+      server.close()\n+      await once(server, 'close')\n+    })\n+\n+    const response = await client.request({\n+      method: 'GET',\n+      path: '/'\n+    })\n+\n+    const body = await response.body.text()\n+\n+    t.equal(response.statusCode, 200)\n+    t.equal(response.headers['content-encoding'], encoding)\n+    t.equal(body, 'This has unsupported encoding')\n+\n+    await t.completed\n+  })\n+}\n+\n test('should pass through error responses (4xx, 5xx)', async t => {\n   t = tspl(t, { plan: 3 })\n "}]}