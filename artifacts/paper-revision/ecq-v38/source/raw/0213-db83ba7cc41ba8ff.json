/plain')\n+    t.assert.strictEqual(res.headers['content-length'], String(Buffer.byteLength('custom HEAD response')))\n     t.assert.strictEqual(res.statusCode, 200)\n     done()\n   })"},{"sha":"f2284648215ea3af0db292d5d35bf04e99c4d908","filename":"test/internals/all.test.js","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/fastify/fastify/blob/55ea28d0043922e9c3e89c24b97fe1895a050e8d/test%2Finternals%2Fall.test.js","raw_url":"https://github.com/fastify/fastify/raw/55ea28d0043922e9c3e89c24b97fe1895a050e8d/test%2Finternals%2Fall.test.js","contents_url":"https://api.github.com/repos/fastify/fastify/contents/test%2Finternals%2Fall.test.js?ref=55ea28d0043922e9c3e89c24b97fe1895a050e8d","patch":"@@ -33,6 +33,11 @@ test('fastify.all should add all the methods to the same url', async t => {\n     }\n \n     const res = await fastify.inject(options)\n+    if (method === 'HEAD') {\n+      // A HEAD response has no body, only the headers of the GET-like response\n+      t.assert.strictEqual(res.headers['content-length'], String(Buffer.byteLength(JSON.stringify({ method }))))\n+      return\n+    }\n     const payload = JSON.parse(res.payload)\n     t.assert.deepStrictEqual(payload, { method })\n   }"}]}