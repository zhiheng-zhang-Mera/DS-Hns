 }\n   }, (err, res) => {\n     t.assert.ifError(err)\n-    t.assert.deepStrictEqual(res.payload, 'custom HEAD response')\n+    // A HEAD response has no body, so check the headers set by the custom HEAD handler\n+    t.assert.strictEqual(res.headers['content-type'], 'text/plain')\n+    t.assert.strictEqual(res.headers['content-length'], String(Buffer.byteLength('custom HEAD response')))\n     t.assert.strictEqual(res.statusCode, 200)\n     done()\n   })"},{"sha":"f2284648215ea3af0db292d5d35bf04e99c4d908","filename":"test/internals/all.test.js","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/fastify/fastify/blob/85b889874fcaea241758c7ebd2efc920d77c1202/test%2Finternals%2Fall.test.js","raw_url":"https://github.com/fastify/fastify/raw/85b889874fcaea241758c7ebd2efc920d77c1202/test%2Finternals%2Fall.test.js","contents_url":"https://api.github.com/repos/fastify/fastify/contents/test%2Finternals%2Fall.test.js?ref=85b889874fcaea241758c7ebd2efc920d77c1202","patch":"@@ -33,6 +33,11 @@ test('fastify.all should add all the methods to the same url', async t => {\n     }\n \n     const res = await fastify.inject(options)\n+    if (method === 'HEAD') {\n+      // A HEAD response has no body, only the headers of the GET-like response\n+      t.assert.strictEqual(res.headers['content-length'], String(Buffer.byteLength(JSON.stringify({ method }))))\n+      return\n+    }\n     const payload = JSON.parse(res.payload)\n     t.assert.deepStrictEqual(payload, { method })\n   }"}]}