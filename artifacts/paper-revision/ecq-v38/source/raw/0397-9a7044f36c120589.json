thub.com/users/ujjawal-yadav","html_url":"https://github.com/ujjawal-yadav","followers_url":"https://api.github.com/users/ujjawal-yadav/followers","following_url":"https://api.github.com/users/ujjawal-yadav/following{/other_user}","gists_url":"https://api.github.com/users/ujjawal-yadav/gists{/gist_id}","starred_url":"https://api.github.com/users/ujjawal-yadav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ujjawal-yadav/subscriptions","organizations_url":"https://api.github.com/users/ujjawal-yadav/orgs","repos_url":"https://api.github.com/users/ujjawal-yadav/repos","events_url":"https://api.github.com/users/ujjawal-yadav/events{/privacy}","received_events_url":"https://api.github.com/users/ujjawal-yadav/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/fastify/fastify/actions/runs/39309568115/jobs","logs_url":"https://api.github.com/repos/fastify/fastify/actions/runs/39309568115/logs","check_suite_url":"https://api.github.com/repos/fastify/fastify/check-suites/106523796876","artifacts_url":"https://api.github.com/repos/fastify/fastify/actions/runs/39309568115/artifacts","cancel_url":"https://api.github.com/repos/fastify/fastify/actions/runs/39309568115/cancel","rerun_url":"https://api.github.com/repos/fastify/fastify/actions/runs/39309568115/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/fastify/fastify/actions/workflows/28864765","head_commit":{"id":"f871941b6551882d969154bbe76ba251211d67cc","tree_id":"42c5c9399922b1d1edaaf53d7e48eefa73f38701","message":"fix: handle web Response in auto-exposed HEAD route\n\nFastify auto-exposes a HEAD route for each GET route and supports returning a\nweb Response from a handler. When a GET handler returned a Response, a HEAD\nrequest to that route crashed with HTTP 500: headRouteOnSendHandler runs in the\nonSend phase, before reply.js unwraps the Response, so it received the raw\nResponse object (which matches neither the node stream nor the web stream\nguard) and reached Buffer.byteLength, which throws on a Response.\n\nThe HEAD onSend handler now recognises a web Response and mirrors reply.js:\napplies the Response status and headers, rejects an already-consumed body with\nFST_ERR_REP_RESPONSE_BODY_CONSUMED (same as GET, so HEAD does not silently\nsucceed where GET fails), otherwise cancels the ReadableStream and sends an\nempty body. A HEAD request now behaves like the equivalent GET.\n\nAdds tests: a GET route returning a Response is stripped to an empty body on\nHEAD (200, headers preserved, content-length parity with GET), and a consumed\nResponse body errors on HEAD exactly as on GET.\n\nSigned-off-by: Ujjawal Yadav <81307555+ujjawal-yadav@users.noreply.github.com>","timestamp":"2026-10-19T19:16:10Z","author":{"name":"Ujjawal Yadav","email":"81307555+ujjawal-yadav@users.noreply.github.com"},"committer":{"name":"Ujjawal Yadav","email":"81307555+ujjawal-yadav@users.noreply.github.com"}},"repository":{"id":69495170,"node_id":"MDEwOlJlcG9zaXRvcnk2OTQ5NTE3MA==","name":"fastify","full_name":"fastify/fastify","private":false,"owner":{"login":"fastify","id":24939410,"node_id":"MDEyOk9yZ2FuaXphdGlvbjI0OTM5NDEw","avatar_url":"https://avatars.githubusercontent.com/u/24939410?v=4","gravatar_id":"","url":"https://api.github.com/users/fastify","html_url":"https://github.com/fastify","followers_url":"https://api.github.com/users/fastify/followers","following_url":"https://api.github.com/users/fastify/following{/other_user}","gists_url":"https://api.github.com/users/fastify/gists{/gist_id}","starred_url":"https://api.github.com/users/fastify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fastify/subscriptions","organizations_url":"https://api.github.com/users/fastify/orgs","repos_url":"https://api.github.com/users/fastify/repos","events_url":"https://api.github.com/users/fastify/events{/privacy}","received_events_url":"https://api.github.com/users/