f7ed3d7a7fa3ce2e7d33cb7fe2a3f1","filename":"test/decorator.test.js","status":"modified","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/fastify/fastify/blob/2c409a48ab299a8d37b8ae82dcb92404b9a84333/test%2Fdecorator.test.js","raw_url":"https://github.com/fastify/fastify/raw/2c409a48ab299a8d37b8ae82dcb92404b9a84333/test%2Fdecorator.test.js","contents_url":"https://api.github.com/repos/fastify/fastify/contents/test%2Fdecorator.test.js?ref=2c409a48ab299a8d37b8ae82dcb92404b9a84333","patch":"@@ -1328,3 +1328,32 @@ test('Request.setDecorator should update an existing decorator', (t, done) => {\n     })\n   })\n })\n+\n+test('getDecorator should evaluate a getter once', async t => {\n+  const fastify = Fastify()\n+  t.after(() => fastify.close())\n+  let calls = 0\n+  fastify.decorate('value', {\n+    getter () {\n+      return ++calls\n+    }\n+  })\n+\n+  t.assert.strictEqual(fastify.getDecorator('value'), 1)\n+  t.assert.strictEqual(calls, 1)\n+})\n+\n+test('getDecorator should bind the function returned by a getter once', async t => {\n+  const fastify = Fastify()\n+  t.after(() => fastify.close())\n+  let calls = 0\n+  fastify.decorate('method', {\n+    getter () {\n+      calls++\n+      return function () { return this }\n+    }\n+  })\n+\n+  t.assert.strictEqual(fastify.getDecorator('method')(), fastify)\n+  t.assert.strictEqual(calls, 1)\n+})"}]}