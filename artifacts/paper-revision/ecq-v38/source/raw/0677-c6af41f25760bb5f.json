9122c10d/lib%2Finterceptor%2Fdecompress.js","raw_url":"https://github.com/nodejs/undici/raw/f8cd585eed62f7a423a199ecee32511f9122c10d/lib%2Finterceptor%2Fdecompress.js","contents_url":"https://api.github.com/repos/nodejs/undici/contents/lib%2Finterceptor%2Fdecompress.js?ref=f8cd585eed62f7a423a199ecee32511f9122c10d","patch":"@@ -105,8 +105,6 @@ function createMaxSizeLimiter (maxSize) {\n   })\n }\n \n-let warningEmitted = /** @type {boolean} */ (false)\n-\n /**\n  * @typedef {Object} DecompressHandlerOptions\n  * @property {number[]|Readonly<number[]>} [skipStatusCodes=[204, 304]] - List of status codes to skip decompression for\n@@ -550,15 +548,6 @@ class DecompressHandler extends DecoratorHandler {\n  * @returns {Function} - Interceptor function\n  */\n function createDecompressInterceptor (options = {}) {\n-  // Emit experimental warning only once\n-  if (!warningEmitted) {\n-    process.emitWarning(\n-      'DecompressInterceptor is experimental and subject to change',\n-      'ExperimentalWarning'\n-    )\n-    warningEmitted = true\n-  }\n-\n   return (dispatch) => {\n     return (opts, handler) => {\n       if (opts.method === 'HEAD') {"},{"sha":"cd3f017ceccf164bc0a6be88f8d476c630f66aa2","filename":"test/interceptors/decompress.js","status":"modified","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/nodejs/undici/blob/f8cd585eed62f7a423a199ecee32511f9122c10d/test%2Finterceptors%2Fdecompress.js","raw_url":"https://github.com/nodejs/undici/raw/f8cd585eed62f7a423a199ecee32511f9122c10d/test%2Finterceptors%2Fdecompress.js","contents_url":"https://api.github.com/repos/nodejs/undici/contents/test%2Finterceptors%2Fdecompress.js?ref=f8cd585eed62f7a423a199ecee32511f9122c10d","patch":"@@ -2406,3 +2406,14 @@ test('should converge a downstream onResponseEnd throw to a per-request error (G\n \n   await t.completed\n })\n+\n+test('should not emit an ExperimentalWarning', async t => {\n+  const { execFile } = require('node:child_process')\n+  const { promisify } = require('node:util')\n+  const { stderr } = await promisify(execFile)(process.execPath, [\n+    '-e',\n+    'require(process.argv[1]).interceptors.decompress()',\n+    require.resolve('../..')\n+  ])\n+  assert.doesNotMatch(stderr, /DecompressInterceptor/)\n+})"}]}