* text=auto

# Windows shims must stay CRLF: cmd.exe is the one consumer that cares.
*.cmd text eol=crlf

# Everything else is LF in the working tree on every platform. The unit and
# architecture gates read these files as text and match multi-line patterns, so
# a checkout that rewrites line endings turns a source assertion into a
# line-ending assertion. That failure mode is invisible on Linux and shows up
# only as "the input did not match /\n/" on a Windows runner.
*.cjs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.html text eol=lf
*.css text eol=lf

# Immutable qualification evidence must retain byte identity across platforms.
artifacts/qualification/history/1a2fa2c4881cb7337f480c770b25337fd55b7654/** -text
artifacts/qualification/history/5afb25ca07c23d5535301d8ad9a504a6d108a80d/** -text
